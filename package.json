{
  "name": "piggylock",
  "version": "0.1.0",
  "description": "PiggyLock \u2014 a MiniPay USDT savings vault",
  "private": true,
  "scripts": {
    "build": "pnpm contracts:compile && pnpm web:build && pnpm site:build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "contracts:compile": "pnpm --filter hardhat compile",
    "contracts:test": "pnpm --filter hardhat test",
    "contracts:node": "pnpm --filter hardhat node",
    "contracts:deploy:local": "pnpm --filter hardhat deploy:local",
    "contracts:deploy:celo-sepolia": "pnpm --filter hardhat deploy:celo-sepolia",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "site:dev": "pnpm --filter site dev",
    "site:build": "pnpm --filter site build"
  },
  "devDependencies": {
    "turbo": "^1.10.16",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.12.0"
  }
}
