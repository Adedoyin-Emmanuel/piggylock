# Deployer key for Celo Sepolia. Use a fresh TESTNET-ONLY key — never one
# that holds real funds. Never commit the real .env file.
PRIVATE_KEY=

# Optional: override the Celo Sepolia RPC (default: Forno public RPC).
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# Optional: Etherscan V2 API key, for `pnpm verify` on Celo Sepolia.
ETHERSCAN_API_KEY=

# Optional: set to any value to print a gas report during tests.
REPORT_GAS=
