# Chain the app expects: 11142220 = Celo Sepolia, 31337 = local Hardhat node.
# (42220 = Celo mainnet — only after a reviewed mainnet deployment.)
VITE_CHAIN_ID=11142220

# SavingsVault address on that chain (from apps/contracts/ignition/deployments).
# The accepted token, its decimals and the fee rate are read from the contract.
VITE_VAULT_ADDRESS=

# Optional: RPC URL for reads (default: the chain's public RPC, e.g. Forno).
# VITE_RPC_URL=

# Everything VITE_* is bundled into public client code. Never put secrets here.
